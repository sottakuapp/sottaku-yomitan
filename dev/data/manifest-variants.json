{
    "manifest": {
        "manifest_version": 3,
        "name": "__MSG_extension_name__",
        "short_name": "__MSG_extension_short_name__",
        "version": "$YOMITAN_VERSION",
        "description": "__MSG_extension_description__",
        "default_locale": "en",
        "author": "Sottaku Inc",
        "icons": {
            "16": "images/icon16.png",
            "19": "images/icon19.png",
            "32": "images/icon32.png",
            "38": "images/icon38.png",
            "48": "images/icon48.png",
            "64": "images/icon64.png",
            "128": "images/icon128.png"
        },
        "action": {
            "default_icon": {
                "16": "images/icon16.png",
                "19": "images/icon19.png",
                "32": "images/icon32.png",
                "38": "images/icon38.png",
                "48": "images/icon48.png",
                "64": "images/icon64.png",
                "128": "images/icon128.png"
            },
            "default_title": "__MSG_action_default_title__",
            "default_popup": "action-popup.html"
        },
        "background": {
            "service_worker": "sw.js",
            "type": "module"
        },
        "omnibox": {
            "keyword": "sottaku"
        },
        "browser_specific_settings": {
            "gecko": {
                "id": "sottaku-yomitan@sottaku.app"
            }
        },
        "content_scripts": [
            {
                "run_at": "document_idle",
                "matches": [
                    "http://*/*",
                    "https://*/*",
                    "file://*/*"
                ],
                "match_about_blank": true,
                "all_frames": true,
                "js": [
                    "js/app/content-script-wrapper.js"
                ]
            }
        ],
        "minimum_chrome_version": "102.0.0.0",
        "options_ui": {
            "page": "settings.html",
            "open_in_tab": true
        },
        "sandbox": {
            "pages": [
                "template-renderer.html"
            ]
        },
        "permissions": [
            "storage",
            "clipboardWrite",
            "declarativeNetRequest",
            "scripting",
            "offscreen",
            "contextMenus",
            "cookies"
        ],
        "optional_permissions": [
            "clipboardRead",
            "nativeMessaging"
        ],
        "host_permissions": [
            "<all_urls>"
        ],
        "externally_connectable": {
            "matches": [
                "http://127.0.0.1/*",
                "http://localhost/*",
                "https://sottaku.app/*",
                "https://*.sottaku.app/*"
            ]
        },
        "commands": {
            "toggleTextScanning": {
                "suggested_key": {
                    "default": "Alt+Delete"
                },
                "description": "__MSG_command_toggle_text_scanning__"
            },
            "openInfoPage": {
                "description": "__MSG_command_open_info_page__"
            },
            "openSettingsPage": {
                "description": "__MSG_command_open_settings_page__"
            },
            "openSearchPage": {
                "suggested_key": {
                    "default": "Alt+Insert"
                },
                "description": "__MSG_command_open_search_page__"
            },
            "openSearchPageCurrentTab": {
                "description": "__MSG_command_open_search_page_current_tab__"
            },
            "openPopupWindow": {
                "description": "__MSG_command_open_popup_window__"
            }
        },
        "web_accessible_resources": [
            {
                "resources": [
                    "popup.html",
                    "template-renderer.html",
                    "js/*",
                    "lib/resvg.wasm"
                ],
                "matches": [
                    "<all_urls>"
                ]
            }
        ],
        "content_security_policy": {
            "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src blob: 'self'; style-src 'self' 'unsafe-inline'; media-src *; connect-src *",
            "sandbox": "sandbox allow-scripts; default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'unsafe-inline'"
        }
    },
    "defaultVariant": "base",
    "variants": [
        {
            "name": "base",
            "buildable": false
        },
        {
            "name": "chrome",
            "inherit": "base",
            "fileName": "sottaku-yomitan-chrome.zip",
            "excludeFiles": [
                "background.html"
            ]
        },
        {
            "name": "chrome-dev",
            "inherit": "chrome",
            "fileName": "sottaku-yomitan-chrome-dev.zip",
            "modifications": [
                {
                    "action": "set",
                    "path": [
                        "name"
                    ],
                    "value": "__MSG_extension_name_dev__"
                },
                {
                    "action": "set",
                    "path": [
                        "description"
                    ],
                    "value": "__MSG_extension_description_dev__"
                }
            ]
        },
        {
            "name": "chrome-playwright",
            "inherit": "chrome-dev",
            "fileName": "sottaku-yomitan-chrome-playwright.zip",
            "modifications": [
                {
                    "action": "remove",
                    "path": [
                        "optional_permissions"
                    ],
                    "item": "clipboardRead"
                },
                {
                    "action": "add",
                    "path": [
                        "permissions"
                    ],
                    "items": [
                        "clipboardRead"
                    ]
                }
            ]
        },
        {
            "name": "firefox",
            "inherit": "base",
            "fileName": "sottaku-yomitan-firefox.zip",
            "modifications": [
                {
                    "action": "set",
                    "path": [
                        "author"
                    ],
                    "value": "Sottaku Inc"
                },
                {
                    "action": "delete",
                    "path": [
                        "background",
                        "service_worker"
                    ]
                },
                {
                    "action": "delete",
                    "path": [
                        "background",
                        "type"
                    ]
                },
                {
                    "action": "set",
                    "path": [
                        "background",
                        "page"
                    ],
                    "value": "background.html"
                },
                {
                    "action": "remove",
                    "path": [
                        "web_accessible_resources",
                        0,
                        "resources"
                    ],
                    "item": "template-renderer.html"
                },
                {
                    "action": "delete",
                    "path": [
                        "sandbox"
                    ]
                },
                {
                    "action": "delete",
                    "path": [
                        "content_security_policy",
                        "sandbox"
                    ]
                },
                {
                    "action": "set",
                    "path": [
                        "content_security_policy",
                        "extension_pages"
                    ],
                    "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src blob: 'self'; style-src 'self' 'unsafe-inline'; media-src *; connect-src *"
                },
                {
                    "action": "set",
                    "path": [
                        "browser_specific_settings"
                    ],
                    "value": {
                        "gecko": {
                            "id": "sottaku-yomitan@sottaku.app",
                            "strict_min_version": "115.0",
                            "data_collection_permissions": {
                                "required": [
                                    "websiteContent",
                                    "authenticationInfo"
                                ]
                            }
                        },
                        "gecko_android": {
                            "strict_min_version": "115.0"
                        }
                    }
                },
                {
                    "action": "remove",
                    "path": [
                        "permissions"
                    ],
                    "item": "offscreen"
                }
            ],
            "excludeFiles": [
                "sw.js",
                "offscreen.html",
                "js/background/offscreen.js",
                "js/background/offscreen-main.js"
            ]
        },
        {
            "name": "firefox-dev",
            "inherit": "firefox",
            "fileName": "sottaku-yomitan-firefox-dev.zip",
            "modifications": [
                {
                    "action": "set",
                    "path": [
                        "name"
                    ],
                    "value": "__MSG_extension_name_dev__"
                },
                {
                    "action": "set",
                    "path": [
                        "description"
                    ],
                    "value": "__MSG_extension_description_dev__"
                },
                {
                    "action": "set",
                    "path": [
                        "browser_specific_settings",
                        "gecko",
                        "id"
                    ],
                    "value": "sottaku-yomitan-dev@sottaku.app"
                }
            ],
            "excludeFiles": [
                "sw.js",
                "offscreen.html",
                "js/background/offscreen.js",
                "js/background/offscreen-main.js"
            ]
        },
        {
            "name": "firefox-android",
            "inherit": "firefox",
            "fileName": "sottaku-yomitan-firefox-android"
        },
        {
            "name": "safari",
            "modifications": [
                {
                    "action": "set",
                    "path": [
                        "author"
                    ],
                    "value": "Sottaku"
                },
                {
                    "action": "remove",
                    "path": [
                        "optional_permissions"
                    ],
                    "item": "clipboardRead"
                },
                {
                    "action": "remove",
                    "path": [
                        "permissions"
                    ],
                    "item": "offscreen"
                },
                {
                    "action": "delete",
                    "path": [
                        "content_scripts",
                        0,
                        "match_about_blank"
                    ]
                },
                {
                    "action": "delete",
                    "path": [
                        "sandbox"
                    ]
                },
                {
                    "action": "set",
                    "path": [
                        "content_security_policy"
                    ],
                    "value": "default-src 'self'; script-src 'self' 'unsafe-eval'; img-src blob: 'self'; style-src 'self' 'unsafe-inline'; media-src *; connect-src *"
                }
            ],
            "excludeFiles": [
                "sw.js",
                "offscreen.html",
                "js/background/offscreen.js",
                "js/background/offscreen-main.js"
            ]
        },
        {
            "name": "edge",
            "inherit": "base",
            "fileName": "sottaku-yomitan-edge.zip",
            "excludeFiles": [
                "background.html"
            ]
        }
    ]
}
