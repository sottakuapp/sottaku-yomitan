{
    "manifest": {
        "manifest_version": 3,
        "name": "__MSG_extension_name__",
        "short_name": "__MSG_extension_short_name__",
        "version": "$YOMITAN_VERSION",
        "description": "__MSG_extension_description__",
        "default_locale": "en",
        "author": "Sottaku Inc",
        "icons": {
            "16": "images/icon16.png",
            "19": "images/icon19.png",
            "32": "images/icon32.png",
            "38": "images/icon38.png",
            "48": "images/icon48.png",
            "64": "images/icon64.png",
            "128": "images/icon128.png"
        },
        "action": {
            "default_icon": {
                "16": "images/icon16.png",
                "19": "images/icon19.png",
                "32": "images/icon32.png",
                "38": "images/icon38.png",
                "48": "images/icon48.png",
                "64": "images/icon64.png",
                "128": "images/icon128.png"
            },
            "default_title": "__MSG_action_default_title__",
            "default_popup": "action-popup.html"
        },
        "background": {
            "service_worker": "sw.js",
            "type": "module"
        },
        "omnibox": {
            "keyword": "sottaku"
        },
        "browser_specific_settings": {
            "gecko": {
                "id": "sottaku-yomitan@sottaku.app"
            }
        },
        "minimum_chrome_version": "102.0.0.0",
        "options_ui": {
            "page": "settings.html",
            "open_in_tab": true
        },
        "sandbox": {
            "pages": [
                "template-renderer.html"
            ]
        },
        "permissions": [
            "storage",
            "clipboardWrite",
            "declarativeNetRequest",
            "scripting",
            "offscreen",
            "contextMenus"
        ],
        "optional_permissions": [
            "clipboardRead",
            "nativeMessaging"
        ],
        "host_permissions": [
            "https://sottaku.app/*",
            "https://staging.sottaku.app/*",
            "https://cdn.sottaku.app/*"
        ],
        "optional_host_permissions": [
            "<all_urls>"
        ],
        "externally_connectable": {
            "matches": [
                "http://127.0.0.1/*",
                "http://localhost/*",
                "https://sottaku.app/*",
                "https://staging.sottaku.app/*"
            ]
        },
        "commands": {
            "toggleTextScanning": {
                "suggested_key": {
                    "default": "Alt+Delete"
                },
                "description": "__MSG_command_toggle_text_scanning__"
            },
            "openInfoPage": {
                "description": "__MSG_command_open_info_page__"
            },
            "openSettingsPage": {
                "description": "__MSG_command_open_settings_page__"
            },
            "openSearchPage": {
                "suggested_key": {
                    "default": "Alt+Insert"
                },
                "description": "__MSG_command_open_search_page__"
            },
            "openSearchPageCurrentTab": {
                "description": "__MSG_command_open_search_page_current_tab__"
            },
            "openPopupWindow": {
                "description": "__MSG_command_open_popup_window__"
            }
        },
        "web_accessible_resources": [
            {
                "resources": [
                    "popup.html",
                    "js/app/content-script-main.js",
                    "js/app/frontend.js",
                    "js/app/popup-factory.js",
                    "js/app/popup-proxy.js",
                    "js/app/popup-window.js",
                    "js/app/popup.js",
                    "js/app/theme-controller.js",
                    "js/application.js",
                    "js/comm/api.js",
                    "js/comm/cross-frame-api.js",
                    "js/comm/frame-ancestry-handler.js",
                    "js/comm/frame-client.js",
                    "js/comm/frame-offset-forwarder.js",
                    "js/core/api-map.js",
                    "js/core/dynamic-property.js",
                    "js/core/event-dispatcher.js",
                    "js/core/event-listener-collection.js",
                    "js/core/extension-error.js",
                    "js/core/json.js",
                    "js/core/log.js",
                    "js/core/object-utilities.js",
                    "js/core/promise-animation-frame.js",
                    "js/core/safe-performance.js",
                    "js/core/to-error.js",
                    "js/core/utilities.js",
                    "js/data/profiles-util.js",
                    "js/data/string-util.js",
                    "js/dom/document-util.js",
                    "js/dom/dom-text-scanner.js",
                    "js/dom/query-selector.js",
                    "js/dom/style-util.js",
                    "js/dom/text-source-element.js",
                    "js/dom/text-source-generator.js",
                    "js/dom/text-source-range.js",
                    "js/extension/web-extension.js",
                    "js/input/hotkey-handler.js",
                    "js/language/CJK-util.js",
                    "js/language/text-scanner.js",
                    "js/pages/settings/popup-preview-controller.js"
                ],
                "matches": [
                    "<all_urls>"
                ],
                "use_dynamic_url": true
            }
        ],
        "content_security_policy": {
            "extension_pages": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' blob: data: https://sottaku.app https://staging.sottaku.app; style-src 'self' 'unsafe-inline'; media-src 'self' blob: https://sottaku.app https://staging.sottaku.app https://cdn.sottaku.app; connect-src 'self' https://sottaku.app https://staging.sottaku.app https://cdn.sottaku.app http://127.0.0.1:* http://localhost:*",
            "sandbox": "sandbox allow-scripts; default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'unsafe-inline'"
        }
    },
    "defaultVariant": "base",
    "variants": [
        {
            "name": "base",
            "buildable": false
        },
        {
            "name": "chrome",
            "inherit": "base",
            "fileName": "sottaku-yomitan-chrome.zip",
            "excludeFiles": [
                "background.html"
            ]
        },
        {
            "name": "chrome-dev",
            "inherit": "chrome",
            "fileName": "sottaku-yomitan-chrome-dev.zip",
            "modifications": [
                {
                    "action": "set",
                    "path": [
                        "name"
                    ],
                    "value": "__MSG_extension_name_dev__"
                },
                {
                    "action": "set",
                    "path": [
                        "description"
                    ],
                    "value": "__MSG_extension_description_dev__"
                }
            ]
        },
        {
            "name": "chrome-playwright",
            "inherit": "chrome-dev",
            "fileName": "sottaku-yomitan-chrome-playwright.zip",
            "modifications": [
                {
                    "action": "remove",
                    "path": [
                        "optional_permissions"
                    ],
                    "item": "clipboardRead"
                },
                {
                    "action": "add",
                    "path": [
                        "permissions"
                    ],
                    "items": [
                        "clipboardRead"
                    ]
                }
            ]
        },
        {
            "name": "firefox",
            "inherit": "base",
            "fileName": "sottaku-yomitan-firefox.zip",
            "modifications": [
                {
                    "action": "set",
                    "path": [
                        "author"
                    ],
                    "value": "Sottaku Inc"
                },
                {
                    "action": "delete",
                    "path": [
                        "background",
                        "service_worker"
                    ]
                },
                {
                    "action": "delete",
                    "path": [
                        "background",
                        "type"
                    ]
                },
                {
                    "action": "set",
                    "path": [
                        "background",
                        "page"
                    ],
                    "value": "background.html"
                },
                {
                    "action": "delete",
                    "path": [
                        "sandbox"
                    ]
                },
                {
                    "action": "delete",
                    "path": [
                        "content_security_policy",
                        "sandbox"
                    ]
                },
                {
                    "action": "set",
                    "path": [
                        "content_security_policy",
                        "extension_pages"
                    ],
                    "value": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' blob: data: https://sottaku.app https://staging.sottaku.app; style-src 'self' 'unsafe-inline'; media-src 'self' blob: https://sottaku.app https://staging.sottaku.app https://cdn.sottaku.app; connect-src 'self' https://sottaku.app https://staging.sottaku.app https://cdn.sottaku.app http://127.0.0.1:* http://localhost:*"
                },
                {
                    "action": "set",
                    "path": [
                        "browser_specific_settings"
                    ],
                    "value": {
                        "gecko": {
                            "id": "sottaku-yomitan@sottaku.app",
                            "strict_min_version": "115.0",
                            "data_collection_permissions": {
                                "required": [
                                    "websiteContent",
                                    "authenticationInfo"
                                ]
                            }
                        },
                        "gecko_android": {
                            "strict_min_version": "115.0"
                        }
                    }
                },
                {
                    "action": "remove",
                    "path": [
                        "permissions"
                    ],
                    "item": "offscreen"
                }
            ],
            "excludeFiles": [
                "sw.js",
                "offscreen.html",
                "js/background/offscreen.js",
                "js/background/offscreen-main.js"
            ]
        },
        {
            "name": "firefox-dev",
            "inherit": "firefox",
            "fileName": "sottaku-yomitan-firefox-dev.zip",
            "modifications": [
                {
                    "action": "set",
                    "path": [
                        "name"
                    ],
                    "value": "__MSG_extension_name_dev__"
                },
                {
                    "action": "set",
                    "path": [
                        "description"
                    ],
                    "value": "__MSG_extension_description_dev__"
                },
                {
                    "action": "set",
                    "path": [
                        "browser_specific_settings",
                        "gecko",
                        "id"
                    ],
                    "value": "sottaku-yomitan-dev@sottaku.app"
                }
            ],
            "excludeFiles": [
                "sw.js",
                "offscreen.html",
                "js/background/offscreen.js",
                "js/background/offscreen-main.js"
            ]
        },
        {
            "name": "firefox-android",
            "inherit": "firefox",
            "fileName": "sottaku-yomitan-firefox-android"
        },
        {
            "name": "safari",
            "modifications": [
                {
                    "action": "set",
                    "path": [
                        "author"
                    ],
                    "value": "Sottaku"
                },
                {
                    "action": "remove",
                    "path": [
                        "optional_permissions"
                    ],
                    "item": "clipboardRead"
                },
                {
                    "action": "remove",
                    "path": [
                        "permissions"
                    ],
                    "item": "offscreen"
                },
                {
                    "action": "delete",
                    "path": [
                        "sandbox"
                    ]
                },
                {
                    "action": "set",
                    "path": [
                        "content_security_policy"
                    ],
                    "value": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-eval'; img-src 'self' blob: data: https://sottaku.app https://staging.sottaku.app; style-src 'self' 'unsafe-inline'; media-src 'self' blob: https://sottaku.app https://staging.sottaku.app https://cdn.sottaku.app; connect-src 'self' https://sottaku.app https://staging.sottaku.app https://cdn.sottaku.app http://127.0.0.1:* http://localhost:*"
                }
            ],
            "excludeFiles": [
                "sw.js",
                "offscreen.html",
                "js/background/offscreen.js",
                "js/background/offscreen-main.js"
            ]
        },
        {
            "name": "edge",
            "inherit": "base",
            "fileName": "sottaku-yomitan-edge.zip",
            "excludeFiles": [
                "background.html"
            ]
        }
    ]
}
